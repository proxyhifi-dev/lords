# ══════════════════════════════════════════════════════
#  Lords Bot — .env.example
#  Copy this file to .env and fill in your values.
#  Never commit your real .env to git.
# ══════════════════════════════════════════════════════

# ────────────────────────────
# SAMCO CREDENTIALS (required for live + real data)
# Fill these on your local PC only. Do NOT commit.
# ────────────────────────────
SAMCO_USER_ID=
SAMCO_PASSWORD=
SAMCO_YOB=
SAMCO_ACCESS_TOKEN=

# ────────────────────────────
# TELEGRAM ALERTS (optional)
# Leave blank to disable.
# ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ────────────────────────────
# APP MODE
# paper = safe testing (no real orders)
# live  = real orders via SAMCO
# ────────────────────────────
MODE=paper
PAPER_MODE_USE_BROKER=true
USE_REDIS=false

STRATEGY_TYPE=iron_condor
IRON_CONDOR_ENABLED=true

# ────────────────────────────
# CAPITAL / ORDER
# ORDER_QTY=65 matches one NIFTY lot (50) + hedge buffer — do not change.
# ────────────────────────────
CAPITAL=50000
ORDER_QTY=65
MAX_DAILY_LOSS=3000
MAX_TRADES=10

NIFTY_SYMBOL=NIFTY 50
NIFTY_EXCHANGE=NSE

POLL_SECONDS=1

# One trade per day — 86400s cooldown between signals
SIGNAL_COOLDOWN=86400
SIGNAL_COOLDOWN_SECONDS=60

# ────────────────────────────
# SCHEDULER / MARKET HOURS
# ────────────────────────────
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
CLOSED_LOG_INTERVAL_SECONDS=60
STARTUP_RECONCILE_TIMEOUT_SECONDS=30
BROKER_QUOTE_TIMEOUT_SECONDS=3
DAILY_RESET_CHECK_INTERVAL_SECONDS=10
MANUAL_FLATTEN_COOLDOWN_SECONDS=180
SCHEDULER_STALL_WARN_SECONDS=10
SCHEDULER_STALL_HARD_SECONDS=60

# ────────────────────────────
# IRON CONDOR CYCLE CONTROL
# IC_ONE_PER_DAY=true  → one trade per calendar day
# IC_MONTHLY_ONLY=true → one trade per month (day 1–5 only)
# ────────────────────────────
IC_ONE_PER_DAY=true
IC_SKIP_EXPIRY_DAY_ENTRY=true
IC_SKIP_EXPIRY_DAY_ENTRY_USE_NEXT_WEEK=false
IC_MONTHLY_ONLY=false
IC_ENTRY_DAY_START=1
IC_ENTRY_DAY_END=31

# ────────────────────────────
# IRON CONDOR ENTRY WINDOW
# Best IV stability is in the first hour (09:30–10:30).
# Entry is blocked after NO_ENTRY_AFTER.
# ────────────────────────────
IC_ENTRY_WINDOW_START=09:30
IC_ENTRY_WINDOW_END=10:30
NO_ENTRY_AFTER=10:30

# IC_SHORT_DISTANCE=400 places short strikes at ~10-delta (BSM).
# At NIFTY 24000, IV=15%, 7 DTE → short strikes ~600 pts OTM.
# Lower values (200–250) = 20-delta, lower PoP, higher premium.
IC_SHORT_DISTANCE=400
IC_WING_WIDTH=100
IC_STRIKE_ROUNDING=50

# Minimum net credit to accept an entry.
# Do not set below 20 — too little premium for the risk.
IC_MIN_ENTRY_PREMIUM=20
IC_MIN_GROSS_PROFIT=250
IC_MIN_GROSS_TARGET_PROFIT=350
IC_MIN_NET_TARGET_PROFIT=150
IC_CHARGES_BUFFER_MULTIPLIER=1.35
IC_MIN_OPTION_PREMIUM=0.05

# Credit quality filters
IC_MIN_REWARD_RISK=0.12
IC_MIN_NET_AFTER_COST_BUFFER=40
IC_MIN_CREDIT_TO_COST_RATIO=1.30
IC_ENTRY_COST_BUFFER_PCT=0.10

# Expected move filter
IC_EXPECTED_MOVE_BUFFER=1.30
IC_HIGH_PROBABILITY_MODE=true
IC_REQUIRE_LIVE_IV=false
IC_MIN_LIVE_IV=0.12
IC_MAX_LIVE_IV=0.24
IC_MIN_SAFETY_BUFFER_POINTS=60

IC_DRAWDOWN_SOFT_PCT=0.12

# Margin / max loss per trade
IC_MARGIN_REQUIRED=40000
IC_MAX_LOSS_PER_TRADE=3000

# Gap / open range protection (skip entry if NIFTY gaps >0.7%)
IC_SKIP_GAP_PCT=0.007
IC_SKIP_OPEN_RANGE_PCT=0.007

# ────────────────────────────
# IRON CONDOR EXIT
# ────────────────────────────
IC_EXIT_TIME=15:00
SQUARE_OFF=14:55

# Target: collect 50% of entry credit before exit
IC_TARGET_PROFIT_PCT=0.50
IC_TARGET_PROFIT=0.50

# Stop loss: exit if premium reaches 2× entry credit (was 1.6× — too tight)
IC_STOP_LOSS_MULTIPLE=2.00

# Extreme loss: exit immediately if premium reaches 3× entry credit
IC_EXTREME_LOSS_MULTIPLE=3.00

IC_EOD_DECISION_TIME=14:35
IC_EOD_MIN_NET_PROFIT=75
IC_SKIP_ONE_DAY_BEFORE_EXPIRY_AFTER_TIME=11:15
IC_QUOTE_CACHE_TTL_SECONDS=3

# ────────────────────────────
# IRON CONDOR MODEL
# IC_DAYS_TO_EXPIRY=1 → same-day / weekly intraday IC
# Change to 7 or 30 for multi-week or monthly expiry.
# ────────────────────────────
IC_DAYS_TO_EXPIRY=1
IC_DECAY_RATE=0.15
IC_MIN_DECAY_FACTOR=0.70

IC_SHORT_OTM_PCT=0.024
IC_LONG_OTM_PCT=0.036
IC_ASSUMED_IV=0.15

# ────────────────────────────
# IRON CONDOR CHARGES
# IC_SLIPPAGE_PER_LEG: pts deducted per leg for bid-ask slippage.
# 4 legs × 3 pts = 12 pts deducted from net credit before viability check.
# ────────────────────────────
IC_SLIPPAGE_PER_LEG=3
IC_BROKERAGE_PER_ORDER=20
IC_ENTRY_ORDER_COUNT=4
IC_EXIT_ORDER_COUNT=4
IC_PLATFORM_CHARGES=100

IC_STT_RATE=0.0015
IC_STT_SELL_RATE=0.0005
IC_EXCHANGE_TXN_RATE=0.00053
IC_SEBI_RATE=0.000001
IC_GST_RATE=0.18
IC_STAMP_DUTY_RATE=0.00003

# ────────────────────────────
# GLOBAL RISK
# Stop trading after 3 consecutive losses or 20% drawdown.
# ────────────────────────────
MAX_CONSECUTIVE_LOSSES=3
MAX_DRAWDOWN_PCT=0.20

# ────────────────────────────
# FILES / APP
# ────────────────────────────
TRADES_FILE=data/trades.csv
STATE_FILE=data/runtime_state.json
LOG_FILE=logs/bot.log

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
FRONTEND_DIR=frontend

# ────────────────────────────
# CONNECTION / SAFETY
# ────────────────────────────
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_BASE_DELAY=1
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
DEADMAN_TIMEOUT=30
RECONCILIATION_INTERVAL_SECONDS=300
