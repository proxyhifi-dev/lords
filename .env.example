# Default safe mode
# TELEGRAM
# ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ────────────────────────────
# APP MODE
# paper = safe testing
# live  = real orders
# ────────────────────────────
MODE=paper
PAPER_MODE_USE_BROKER=true
USE_REDIS=false

STRATEGY_TYPE=iron_condor
IRON_CONDOR_ENABLED=true

# ────────────────────────────
# CAPITAL / ORDER
# ────────────────────────────
CAPITAL=50000
ORDER_QTY=65
MAX_DAILY_LOSS=2500
MAX_TRADES=1

NIFTY_SYMBOL=NIFTY 50
NIFTY_EXCHANGE=NSE

POLL_SECONDS=1

# Global cooldowns
SIGNAL_COOLDOWN=300
SIGNAL_COOLDOWN_SECONDS=300

# ────────────────────────────
# SCHEDULER / MARKET HOURS
# ────────────────────────────
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
CLOSED_LOG_INTERVAL_SECONDS=60
STARTUP_RECONCILE_TIMEOUT_SECONDS=30
BROKER_QUOTE_TIMEOUT_SECONDS=3
DAILY_RESET_CHECK_INTERVAL_SECONDS=10
MANUAL_FLATTEN_COOLDOWN_SECONDS=180
SCHEDULER_STALL_WARN_SECONDS=15
SCHEDULER_STALL_HARD_SECONDS=60

# ────────────────────────────
# IRON CONDOR CYCLE CONTROL
# false = allow IC daily
# true  = only monthly cycle
# ────────────────────────────
IC_ONE_PER_DAY=true
IC_SKIP_EXPIRY_DAY_ENTRY=true
IC_MONTHLY_ONLY=false
IC_ENTRY_DAY_START=1
IC_ENTRY_DAY_END=31

# ────────────────────────────
# IRON CONDOR ENTRY
# ────────────────────────────
IC_ENTRY_WINDOW_START=09:45
IC_ENTRY_WINDOW_END=11:15
NO_ENTRY_AFTER=11:15

# Your old 250 distance created only ₹5 premium.
# 180–200 is more realistic for intraday NIFTY IC.
IC_SHORT_DISTANCE=200
IC_WING_WIDTH=100
IC_STRIKE_ROUNDING=50

# Do not reduce this to 5. That gives bad risk/reward.
IC_MIN_ENTRY_PREMIUM=22
IC_MIN_GROSS_PROFIT=250
IC_MIN_GROSS_TARGET_PROFIT=350
IC_MIN_NET_TARGET_PROFIT=150
IC_CHARGES_BUFFER_MULTIPLIER=1.35
IC_MIN_OPTION_PREMIUM=0.05

# Credit quality filters
IC_MIN_REWARD_RISK=0.12
IC_MIN_NET_AFTER_COST_BUFFER=120
IC_MIN_CREDIT_TO_COST_RATIO=1.60
IC_ENTRY_COST_BUFFER_PCT=0.15

# Expected move filter
# Old 1.30 was too strict with 250 distance.
IC_EXPECTED_MOVE_BUFFER=1.20
IC_HIGH_PROBABILITY_MODE=true
IC_REQUIRE_LIVE_IV=false
IC_MIN_LIVE_IV=0.12
IC_MAX_LIVE_IV=0.24
IC_MIN_SAFETY_BUFFER_POINTS=60

IC_DRAWDOWN_SOFT_PCT=0.12

# Margin / max loss
IC_MARGIN_REQUIRED=40000
IC_MAX_LOSS_PER_TRADE=3000

# Gap / open range protection
IC_SKIP_GAP_PCT=0.007
IC_SKIP_OPEN_RANGE_PCT=0.007

# ────────────────────────────
# IRON CONDOR EXIT
# ────────────────────────────
IC_EXIT_TIME=15:00
SQUARE_OFF=14:55

IC_TARGET_PROFIT_PCT=0.40
IC_TARGET_PROFIT=0.40
IC_STOP_LOSS_MULTIPLE=1.80
IC_EXTREME_LOSS_MULTIPLE=2.50
IC_EOD_DECISION_TIME=14:35
IC_EOD_MIN_NET_PROFIT=75
IC_SKIP_ONE_DAY_BEFORE_EXPIRY_AFTER_TIME=11:15
IC_QUOTE_CACHE_TTL_SECONDS=3

# ────────────────────────────
# IRON CONDOR MODEL
# For same-day / weekly intraday IC, use 1.
# If you trade true monthly expiry, change to 7 or 30.
# ────────────────────────────
IC_DAYS_TO_EXPIRY=1
IC_DECAY_RATE=0.15
IC_MIN_DECAY_FACTOR=0.70

IC_SHORT_OTM_PCT=0.0085
IC_LONG_OTM_PCT=0.0125
IC_ASSUMED_IV=0.15

# ────────────────────────────
# IRON CONDOR CHARGES
# ────────────────────────────
IC_BROKERAGE_PER_ORDER=20
IC_ENTRY_ORDER_COUNT=4
IC_EXIT_ORDER_COUNT=4
IC_PLATFORM_CHARGES=100

IC_STT_RATE=0.0015
IC_STT_SELL_RATE=0.0015
IC_EXCHANGE_TXN_RATE=0.0003553
IC_SEBI_RATE=0.000001
IC_GST_RATE=0.18
IC_STAMP_DUTY_RATE=0.00003

# ────────────────────────────
# GLOBAL RISK
# ────────────────────────────
MAX_CONSECUTIVE_LOSSES=2
MAX_DRAWDOWN_PCT=0.20

# ────────────────────────────
# FILES / APP
# ────────────────────────────
TRADES_FILE=data/trades.csv
STATE_FILE=data/runtime_state.json
LOG_FILE=logs/bot.log

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
FRONTEND_DIR=frontend

# ────────────────────────────
# CONNECTION / SAFETY
# ────────────────────────────
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_BASE_DELAY=1
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
DEADMAN_TIMEOUT=30
RECONCILIATION_INTERVAL_SECONDS=300
