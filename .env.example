# Lords Bot — Environment Configuration
# Copy to .env and fill in your SAMCO credentials

# SAMCO Login
SAMCO_USER_ID=YOUR_USER_ID
SAMCO_PASSWORD=YOUR_PASSWORD
SAMCO_YOB=YYYY
SAMCO_ACCESS_TOKEN=

# Trading mode: paper (safe) | live (real orders)
MODE=paper

# Capital and risk
CAPITAL=40000.0
MAX_DAILY_LOSS=3000.0
MAX_TRADES=2

# Order
ORDER_QTY=65

# Strategy
STOP_LOSS_PCT=0.25
T1_PCT=0.40
T2_PCT=1.00
TRAILING_PCT=0.25
MIN_ENTRY_PREMIUM=30.0
MIN_OPTION_VOLUME=500
OTM_DISTANCE=1

# ORB
ORB_DURATION_SECONDS=900
MIN_ORB_RANGE=5.0
BREAKOUT_BUFFER=2.0
SIGNAL_COOLDOWN=60
TREND_FILTER_ENABLED=false

# Timing
NO_ENTRY_AFTER=13:30
SQUARE_OFF=15:10
POLL_SECONDS=2

# Paths
TRADES_FILE=data/trades.csv
STATE_FILE=data/runtime_state.json
LOG_FILE=logs/bot.log
