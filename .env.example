# Default safe mode
MODE=paper
STRATEGY_TYPE=iron_condor
IRON_CONDOR_ENABLED=true

# Required for BOTH paper and live guardrails
CAPITAL=50000
ORDER_QTY=50
MAX_DAILY_LOSS=5000
MAX_TRADES=2

# Required for LIVE mode only
SAMCO_USER_ID=YOUR_SAMCO_USER_ID
SAMCO_PASSWORD=YOUR_SAMCO_PASSWORD
SAMCO_YOB=YYYY
SAMCO_ACCESS_TOKEN=

# Iron Condor controls
IC_ENTRY_DAY_START=1
IC_ENTRY_DAY_END=5
IC_ENTRY_WINDOW_START=09:20
IC_ENTRY_WINDOW_END=10:00
IC_TARGET_PROFIT=0.50
IC_STOP_LOSS_MULTIPLE=1.50
IC_MIN_ENTRY_PREMIUM=50
IC_SHORT_OTM_PCT=0.03
IC_LONG_OTM_PCT=0.06
IC_STRIKE_ROUNDING=50
IC_MARGIN_REQUIRED=40000
IC_MAX_LOSS_PER_TRADE=10000

# Runtime files
TRADES_FILE=data/trades.csv
STATE_FILE=data/runtime_state.json
LOG_FILE=logs/bot.log
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
FRONTEND_DIR=frontend
