# ── SAMCO CREDENTIALS ──────────────────────────────────────────
SAMCO_USER_ID=YOUR_USER_ID
SAMCO_PASSWORD=YOUR_PASSWORD
SAMCO_YOB=YYYY                      # year of birth
SAMCO_ACCESS_TOKEN=                 # optional TOTP / access token

# ── MARKET ─────────────────────────────────────────────────────
NIFTY_SYMBOL=NIFTY 50
NIFTY_EXCHANGE=NSE
POLL_SECONDS=1                      # how often to poll spot price (seconds)

# ── TRADING ────────────────────────────────────────────────────
ORDER_QTY=50                        # 1 lot = 50 shares
MAX_DAILY_LOSS=5000                 # ₹ daily loss limit
MAX_TRADES=3                        # max trades per day
STOP_LOSS_PCT=0.30                  # 30% SL below entry premium
TARGET_PCT=0.60                     # 60% target above entry premium
TRAILING_PCT=0.20                   # 20% trailing SL from peak
MIN_OPTION_VOLUME=0                 # set > 0 to skip illiquid options

# ── ORB SETTINGS ───────────────────────────────────────────────
ORB_START=09:15
ORB_END=09:30
ORB_DURATION_SECONDS=900            # 15 minutes
MIN_ORB_RANGE=5.0                   # min ORB width to trade
BREAKOUT_BUFFER=2.0                 # buffer beyond ORB high/low
SIGNAL_COOLDOWN=10                  # seconds between signals
GAP_THRESHOLD=5.0                   # gap-open threshold

# ── SQUARE OFF ─────────────────────────────────────────────────
NO_ENTRY_AFTER=15:10
SQUARE_OFF=15:15

# ── RECONNECT ──────────────────────────────────────────────────
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_BASE_DELAY=1

# ── CIRCUIT BREAKER ────────────────────────────────────────────
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30

# ── STORAGE ────────────────────────────────────────────────────
TRADES_FILE=backend/storage/trades.json
STATE_FILE=backend/storage/runtime_state.json
LOG_FILE=backend/logs/bot.log

# ── DASHBOARD ──────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
FRONTEND_DIR=frontend
