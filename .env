# ══════════════════════════════════════════════════════
#  Lords Bot v5.0 — Configuration
#  ALL settings here. Nothing hardcoded in code.
#  ⚠️  NEVER share this file — it contains your password.
#  Share .env.example instead.
# ══════════════════════════════════════════════════════

# ── SAMCO CREDENTIALS ─────────────────────────────────
# ⚠️  CHANGE YOUR PASSWORD — these were exposed in a shared file
SAMCO_USER_ID=DB41588
SAMCO_PASSWORD=
SAMCO_YOB=1998
SAMCO_ACCESS_TOKEN=
# ── APP MODE ──────────────────────────────────────────
# paper = simulate trades (safe)
# live  = real orders on SAMCO (requires restart after change)
MODE=paper

# ── MARKET ────────────────────────────────────────────
NIFTY_SYMBOL=NIFTY 50
NIFTY_EXCHANGE=NSE
POLL_SECONDS=1

# ── CAPITAL & RISK ────────────────────────────────────
CAPITAL=50000
MAX_DAILY_LOSS=5000
MAX_TRADES=3

# ── ORDER ─────────────────────────────────────────────
ORDER_QTY=65

# ── EXIT LEVELS ───────────────────────────────────────
STOP_LOSS_PCT=0.30
T1_PCT=0.40
T2_PCT=1.00
TRAILING_PCT=0.20

# ── ENTRY FILTERS ─────────────────────────────────────
MIN_ENTRY_PREMIUM=30.0
MIN_OPTION_VOLUME=500
OTM_DISTANCE=1

# ── ORB SETTINGS (v4.0 OPTIMISED) ────────────────────
ORB_DURATION_SECONDS=900
MIN_ORB_RANGE=50.0
ORB_MAX_RANGE=150.0
ORB_ATR_MULTIPLIER=1.0
BREAKOUT_BUFFER=5.0
SIGNAL_COOLDOWN=120
GAP_THRESHOLD=5.0

# ── TREND FILTER ──────────────────────────────────────
TREND_FILTER_ENABLED=true
SKIP_FIRST_CANDLE=true

# ── SLIPPAGE MODEL (v5.0) ──────────────────────────
SLIPPAGE_ENTRY=2.0           # ₹ extra on market order entry
SLIPPAGE_EXIT=1.5            # ₹ extra on market order exit
SLIPPAGE_SL_GAP=5.0          # ₹ extra on SL gap fills

# ── TIMING ────────────────────────────────────────────
NO_ENTRY_AFTER=13:30
SQUARE_OFF=15:10

# ── RECONNECT ─────────────────────────────────────────
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_BASE_DELAY=1

# ── CIRCUIT BREAKER ───────────────────────────────────
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30

# ── STORAGE ───────────────────────────────────────────
TRADES_FILE=data/trades.csv
STATE_FILE=data/runtime_state.json
LOG_FILE=logs/bot.log

# ── DASHBOARD ─────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
FRONTEND_DIR=frontend
