# ══════════════════════════════════════════════════════
#  Lords Bot v6.0 — PRODUCTION CONFIG (10/10)
#  Fixed from audit findings. All defects patched.
# ══════════════════════════════════════════════════════

# ── SAMCO CREDENTIALS ─────────────────────────────────
# ⚠️  Rotate these if they were exposed
SAMCO_USER_ID=DB41588
SAMCO_PASSWORD=
SAMCO_YOB=1998
SAMCO_ACCESS_TOKEN=
# ── APP MODE ──────────────────────────────────────────
MODE=paper

# ── MARKET ────────────────────────────────────────────
NIFTY_SYMBOL=NIFTY 50
NIFTY_EXCHANGE=NSE
POLL_SECONDS=1

# ── CAPITAL & RISK ────────────────────────────────────
CAPITAL=110000
MAX_DAILY_LOSS=5000
MAX_TRADES=1
# ✅ FIX: 1 trade/day per direction (not 3)

# ── ORDER ─────────────────────────────────────────────
ORDER_QTY=130

# ── EXIT LEVELS ───────────────────────────────────────
STOP_LOSS_PCT=0.20
# ✅ Tighter stop loss for edge trades
T1_PCT=0.30
# ✅ More realistic first target
T2_PCT=0.60
# ✅ More achievable second target
TRAILING_PCT=0.10
# ✅ Earlier trailing lock
BREAKEVEN_AT_PCT=0.10
# ✅ Protect profits sooner

# ── ENTRY FILTERS ─────────────────────────────────────
MIN_ENTRY_PREMIUM=50.0
# ✅ FIX: Raised from 30 (avoid theta traps)
MIN_OPTION_VOLUME=500
OTM_DISTANCE=1
MAX_SPREAD_PCT=0.04
# ✅ NEW: 4% spread filter (retail killer guard)
MIN_DTE=2
# ✅ NEW: Never trade <2 DTE
MAX_DTE=7
# ✅ NEW: No far-expiry trades

# ── ORB SETTINGS ──────────────────────────────────────
ORB_DURATION_SECONDS=900
MIN_ORB_RANGE_PCT=0.0020
# ✅ FIX: 0.20% of spot (not absolute 50 pts)
MAX_ORB_RANGE_PCT=0.0080
# ✅ NEW: 0.80% max (chaotic day filter)
ORB_ATR_MULTIPLIER=1.0
BREAKOUT_BUFFER=5.0
SIGNAL_COOLDOWN=86400
# ✅ FIX: 1 day (86400s) not 120s — one trade per direction per day
GAP_THRESHOLD=5.0
TREND_FILTER_ENABLED=true
# ✅ Strict trend filter enabled for higher-probability entries
# Set to false only if you want more aggressive signal volume

# ── MOMENTUM FILTERS ───────────────────────────────────
MIN_BREAKOUT_MOMENTUM=0.0015
# ✅ NEW: Require 0.15% immediate momentum on breakout
MIN_VOLUME_SPIKE=1.5
bashREQUIRE_TWO_CANDLE_CONFIRMATION=true
# ✅ NEW: Require 1.5x average volume on breakout candle
MAX_IV_PERCENTILE=70
# ✅ NEW: Reject overly rich IV moves

# ── TIMING ────────────────────────────────────────────
NO_ENTRY_AFTER=11:30
# ✅ Earlier entry cutoff to avoid afternoon theta bleed
SQUARE_OFF=14:55
# ✅ FIX: Pulled from 15:10 (avoid expiry theta crush)

# ── LOGS ──────────────────────────────────────────────
LOG_FILE=logs/bot.log
TRADES_FILE=data/trades.csv
# ── IRON CONDOR SETTINGS ──────────────────────────────
# Main strategy switch
STRATEGY_TYPE=iron_condor

# Entry timing (day 1-5 of month, 9:20-10:00 AM)
IC_ENTRY_DAY_START=1
IC_ENTRY_DAY_END=5
IC_ENTRY_WINDOW_START=09:20
IC_ENTRY_WINDOW_END=10:00

# Exit conditions
IC_TARGET_PROFIT=0.50
IC_STOP_LOSS_MULTIPLE=1.50
IC_DAYS_TO_EXPIRY=30

# Premium estimation
IC_ASSUMED_IV=0.15
IC_MIN_ENTRY_PREMIUM=50.0

# Strike selection
IC_SHORT_OTM_PCT=0.03
IC_LONG_OTM_PCT=0.06
IC_STRIKE_ROUNDING=50

# Decay modeling
IC_DECAY_RATE=0.15

# Charges (2026 rates, zero-brokerage)
IC_STT_RATE=0.0015
IC_PLATFORM_CHARGES=100.0

# Risk management
IC_MARGIN_REQUIRED=40000.0
IC_MAX_LOSS_PER_TRADE=10000.0


