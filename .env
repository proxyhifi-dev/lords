# ══════════════════════════════════════════════════════
#  Lords Bot v6.0 — PRODUCTION CONFIG (10/10)
#  Fixed from audit findings. All defects patched.
# ══════════════════════════════════════════════════════

# ── API SECURITY ──────────────────────────────────────
# Set a strong random value (e.g. openssl rand -hex 32).
# When set, all trade-control POST endpoints require X-API-Key header.
# Leave blank to disable auth (local dev only).
API_SECRET_KEY=

# ── SAMCO CREDENTIALS ─────────────────────────────────
# ⚠️  Rotate these if they were ever exposed.
# Fill these in on your local PC only. Do NOT commit real values.
SAMCO_USER_ID=
SAMCO_PASSWORD=
SAMCO_YOB=
SAMCO_ACCESS_TOKEN=

# ── TELEGRAM ALERTS (optional) ────────────────────────
# Create a bot via @BotFather → get token. Get chat_id via @userinfobot.
# Leave blank to disable alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ────────────────────────────
# APP MODE
# paper = safe testing
# live  = real orders
# ────────────────────────────
MODE=paper
PAPER_MODE_USE_BROKER=true
USE_REDIS=false

STRATEGY_TYPE=iron_condor
IRON_CONDOR_ENABLED=true

CAPITAL=50000
ORDER_QTY=65
MAX_DAILY_LOSS=3000
MAX_TRADES=1

NIFTY_SYMBOL=NIFTY 50
NIFTY_EXCHANGE=NSE

POLL_SECONDS=1
SIGNAL_COOLDOWN_SECONDS=86400

# ────────────────────────────
# SCHEDULER / MARKET HOURS
# ────────────────────────────
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
CLOSED_LOG_INTERVAL_SECONDS=60
STARTUP_RECONCILE_TIMEOUT_SECONDS=30
BROKER_QUOTE_TIMEOUT_SECONDS=3
DAILY_RESET_CHECK_INTERVAL_SECONDS=10
MANUAL_FLATTEN_COOLDOWN_SECONDS=180
SCHEDULER_STALL_WARN_SECONDS=10
SCHEDULER_STALL_HARD_SECONDS=60

# ────────────────────────────
# IRON CONDOR CYCLE CONTROL
# false = allow one IC trade per day
# true  = allow one IC trade per month
# ────────────────────────────
IC_MONTHLY_ONLY=false
IC_ONE_PER_DAY=true
IC_SKIP_EXPIRY_DAY_ENTRY=true
IC_ENTRY_DAY_START=1
IC_ENTRY_DAY_END=5

# ────────────────────────────
# IRON CONDOR ENTRY
# ────────────────────────────
IC_ENTRY_WINDOW_START=09:30
IC_ENTRY_WINDOW_END=10:30
NO_ENTRY_AFTER=10:30

IC_SHORT_DISTANCE=400
IC_WING_WIDTH=150
IC_STRIKE_ROUNDING=50
IC_TARGET_SHORT_DELTA=0.16

IC_MIN_ENTRY_PREMIUM=40
IC_MIN_ENTRY_SCORE=60
IC_MIN_OPTION_PREMIUM=0.05
IC_MIN_REWARD_RISK=0.35
IC_MIN_NET_AFTER_COST_BUFFER=80
IC_MIN_CREDIT_TO_COST_RATIO=2.00
IC_ENTRY_COST_BUFFER_PCT=0.10
IC_EXPECTED_MOVE_BUFFER=1.30
IC_DRAWDOWN_SOFT_PCT=0.12

IC_MARGIN_REQUIRED=40000
IC_MAX_LOSS_PER_TRADE=3000

IC_SKIP_GAP_PCT=0.015
IC_SKIP_OPEN_RANGE_PCT=0.015
# Comma-separated YYYY-MM-DD dates to block IC entry (RBI, Budget, Fed, election days).
# Example: IC_BLACKOUT_DATES=2026-08-07,2026-09-18
IC_BLACKOUT_DATES=
# Minimum session IV Rank (0-1) required to sell premium. Below this IV is crushed.
IC_MIN_IV_RANK=0.50

# ────────────────────────────
# IRON CONDOR EXIT
# ────────────────────────────
IC_EXIT_TIME=15:00
SQUARE_OFF=14:55

IC_TARGET_PROFIT_PCT=0.50
IC_TARGET_PROFIT=0.50
IC_STOP_LOSS_MULTIPLE=1.50
IC_EXTREME_LOSS_MULTIPLE=2.50
# Force-exit when DTE falls below this threshold to avoid expiry-day gamma risk.
IC_FORCE_EXIT_DTE=1

# ────────────────────────────
# IRON CONDOR MODEL
# ────────────────────────────
IC_DAYS_TO_EXPIRY=7
IC_DECAY_RATE=0.15
IC_MIN_DECAY_FACTOR=0.70
IC_SHORT_OTM_PCT=0.024
IC_LONG_OTM_PCT=0.036
IC_ASSUMED_IV=0.15
IC_HIGH_PROBABILITY_MODE=true
IC_REQUIRE_LIVE_IV=true
IC_MIN_LIVE_IV=0.14
IC_MAX_LIVE_IV=0.20

# ────────────────────────────
# IRON CONDOR CHARGES
# ────────────────────────────
IC_SLIPPAGE_PER_LEG=3
IC_BROKERAGE_PER_ORDER=20
IC_ENTRY_ORDER_COUNT=4
IC_EXIT_ORDER_COUNT=4
IC_PLATFORM_CHARGES=100
# IC_STT_RATE is superseded by IC_STT_SELL_RATE below — kept for reference only.
# STT on options sell-side raised to 0.15% from 1 Apr 2026 (Finance Act 2025).
IC_STT_SELL_RATE=0.0015
IC_EXCHANGE_TXN_RATE=0.00035
IC_SEBI_RATE=0.000001
IC_GST_RATE=0.18
IC_STAMP_DUTY_RATE=0.00003

# ────────────────────────────
# GLOBAL RISK
# ────────────────────────────
MAX_CONSECUTIVE_LOSSES=3
MAX_DRAWDOWN_PCT=0.20

# ────────────────────────────
# FILES / APP
# ────────────────────────────
TRADES_FILE=data/trades.csv
# STATE_FILE is not written as JSON. The state manager derives the SQLite path
# by replacing the extension: data/runtime_state.db is what actually persists state.
# STATE_FILE=data/runtime_state.json
LOG_FILE=logs/bot.log

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
FRONTEND_DIR=frontend

RECONNECT_MAX_ATTEMPTS=5
RECONNECT_BASE_DELAY=1
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
DEADMAN_TIMEOUT=60
RECONCILIATION_INTERVAL_SECONDS=300
