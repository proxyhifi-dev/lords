# ══════════════════════════════════════════════════════
#  Lords Bot v6.0 — PRODUCTION CONFIG (10/10)
#  Fixed from audit findings. All defects patched.
# ══════════════════════════════════════════════════════

# ── SAMCO CREDENTIALS ─────────────────────────────────
# ⚠️  Rotate these if they were exposed
SAMCO_USER_ID=DB41588
SAMCO_PASSWORD=
SAMCO_YOB=1998
SAMCO_ACCESS_TOKEN=
# ── APP MODE ──────────────────────────────────────────
MODE=paper

# ── MARKET ────────────────────────────────────────────
NIFTY_SYMBOL=NIFTY 50
NIFTY_EXCHANGE=NSE
POLL_SECONDS=1

# ── CAPITAL & RISK ────────────────────────────────────
CAPITAL=50000
MAX_DAILY_LOSS=5000
MAX_TRADES=1
# ✅ FIX: 1 trade/day per direction (not 3)

# ── ORDER ─────────────────────────────────────────────
ORDER_QTY=65

# ── EXIT LEVELS ───────────────────────────────────────
STOP_LOSS_PCT=0.45
# ✅ IMPROVED: Widened from 30% to 45% (reduces false SL hits)
T1_PCT=0.50
# ✅ IMPROVED: Increased from 40% to 50% (better RR)
T2_PCT=1.25
# ✅ IMPROVED: Increased from 100% to 125% (let winners run)
TRAILING_PCT=0.15
# ✅ IMPROVED: Relaxed from 10% to 15% (less aggressive trailing)
BREAKEVEN_AT_PCT=0.25
# ✅ IMPROVED: Moved from 20% to 25% (earlier breakeven)

# ── ENTRY FILTERS ─────────────────────────────────────
MIN_ENTRY_PREMIUM=50.0
# ✅ FIX: Raised from 30 (avoid theta traps)
MIN_OPTION_VOLUME=500
OTM_DISTANCE=1
MAX_SPREAD_PCT=0.04
# ✅ NEW: 4% spread filter (retail killer guard)
MIN_DTE=2
# ✅ NEW: Never trade <2 DTE
MAX_DTE=7
# ✅ NEW: No far-expiry trades

# ── ORB SETTINGS ──────────────────────────────────────
ORB_DURATION_SECONDS=900
MIN_ORB_RANGE_PCT=0.0020
# ✅ FIX: 0.20% of spot (not absolute 50 pts)
MAX_ORB_RANGE_PCT=0.0080
# ✅ NEW: 0.80% max (chaotic day filter)
ORB_ATR_MULTIPLIER=1.0
BREAKOUT_BUFFER=5.0
SIGNAL_COOLDOWN=86400
# ✅ FIX: 1 day (86400s) not 120s — one trade per direction per day
GAP_THRESHOLD=5.0
TREND_FILTER_ENABLED=false
# ✅ IMPROVED: Disabled strict trend filter (was blocking good trades)
# Set to true only if you want very conservative entries

# ── MOMENTUM FILTERS ───────────────────────────────────
MIN_BREAKOUT_MOMENTUM=0.0015
# ✅ NEW: Require 0.15% immediate momentum on breakout
MIN_VOLUME_SPIKE=1.5
# ✅ NEW: Require 1.5x average volume on breakout candle

# ── TIMING ────────────────────────────────────────────
NO_ENTRY_AFTER=13:30
# ✅ FIX: Pulled from 14:30 (avoid theta bleed)
SQUARE_OFF=14:55
# ✅ FIX: Pulled from 15:10 (avoid expiry theta crush)

# ── LOGS ──────────────────────────────────────────────
LOG_FILE=logs/bot.log
TRADES_FILE=data/trades.csv
